# Optional for localhost or a single persistent Node server.
# Required for a durable guestbook on Vercel/serverless. Run supabase/guestbook.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: a long random value used to salt visitor hashes.
GUESTBOOK_RATE_LIMIT_SECRET=

# Persistent local storage directory on a Node server; defaults to ./data.
# GUESTBOOK_DATA_DIR=/var/lib/wedding-invitations

# Set to the actual deployed origin, e.g. https://your-wedding.example
# NEXT_PUBLIC_SITE_URL=
